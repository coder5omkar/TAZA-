# TAZA-PHAL-SABZI.COM — backend environment
# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development
TZ=Asia/Kolkata

# MySQL (local: root / empty password usually)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taza_sabzi

# Auth — CHANGE THIS to a long random string before deploying!
JWT_SECRET=change-me-to-a-long-random-string
